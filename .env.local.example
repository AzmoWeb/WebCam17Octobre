# Copier ce fichier en .env.local et remplir les valeurs (Supabase > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : utilisée seulement côté serveur, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL d'origine du site (liens de confirmation d'e-mail).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse RTMP affichée aux streamers (sans la clé). En prod : rtmp://ton-serveur/live
NEXT_PUBLIC_RTMP_URL=rtmp://localhost/live

# Accès internes à MediaMTX (doivent rester sur 127.0.0.1).
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_URL=http://127.0.0.1:8888
MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996

# Secret partagé avec mediamtx.yml (runOnReady / runOnNotReady). Mets la même valeur des deux côtés.
MEDIAMTX_HOOK_SECRET=change-me-hook-secret

# Facultatif : captcha Cloudflare Turnstile à l'inscription.
# Active aussi « Bot protection » dans Supabase > Authentication > Attack Protection avec la clé secrète.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
